# Kopiere diese Datei zu ".env" und trage deine Werte ein. Wird nicht committet.

# Adresse von Balu's Training. Im Heimnetz der Homeserver, unterwegs die
# Tailscale-IP (http://100.x.y.z:8200).
BALU_URL=http://homeserver:8200

# Trainer-Zugang - nur damit laedt das Werkzeug die fertigen Clips hoch.
# ACHTUNG: Balu's Training sperrt den Zugang nach 3 Fehlversuchen. PIN genau
# eintragen; bei "Login fehlgeschlagen" nicht einfach neu starten, sondern die
# PIN pruefen.
BALU_TRAINER_NAME=
BALU_TRAINER_PIN=

# Nur falls ffmpeg/ffprobe nicht im PATH liegen: voller Pfad zur exe.
#FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
#FFPROBE=C:\ffmpeg\bin\ffprobe.exe
